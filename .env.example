# Public app configuration. Safe to expose to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Used by the ingestion worker and scripts, never by the browser.
TOKENFACTORY_API_BASE=
TOKENFACTORY_API_KEY=

# Lovable Cloud worker login. Must be an allowed member listed in
# public.ingestion_worker_users (see 0017_worker_rpc.sql).
LIBRARY_USER_EMAIL=
LIBRARY_USER_PASSWORD=

# Optional. Lovable Cloud does not expose these; they are only for self-hosted
# Supabase. SUPABASE_DB_URL is a Postgres URI, not the https://<ref>.supabase.co
# API URL. SUPABASE_SERVICE_ROLE_KEY bypasses RLS.
SUPABASE_DB_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Document pipeline LLM budgets
#
# IMPORTANT: max_tokens INCLUDES reasoning tokens. This provider reasons by
# default, and reasoning alone can consume thousands of tokens, so a budget
# that looks large for the answer can still return an empty completion with
# finish_reason "length". Two rules keep that from happening:
#   - thinking off sends {"chat_template_kwargs":{"thinking":false}};
#   - thinking on is floored at 4000 max_tokens.
# Every value below is clamped to DOC_MAX_TOKENS_CEILING.
#
# Per call type: DOC_THINKING_<TYPE>=on|off and DOC_MAX_TOKENS_<TYPE>=<int>.
#
# Calibrated against the live provider on 2026-11-12 with the IndiGo x
# InterGlobe Hotels x Movin scenario (scripts/calibrate-llm-budget.ts), at ~2x
# the largest observed (reasoning + output) completion per call type:
#   BRIEF   observed 6400 completion tokens -> 13000
#   OUTLINE observed 3022 completion tokens -> 7000 at 2x, raised to 12000
#           because an end-to-end export spent >7000 on reasoning alone
#   SECTION observed 5724 completion tokens -> 12000 at 2x, raised to 16000
#           after a live section spent all 12000 tokens on reasoning (finish
#           "length") and had to retry with a doubled budget
#   VERIFY  not separately calibrated; sized like SECTION -> 12000
# At 4000 tokens with thinking on the brief still returned 0 visible characters
# after 4000 reasoning tokens (finish "length"), and the outline needed its
# entire budget for reasoning at 4000; that is the failure these sizes prevent.
# QUERY_REWRITE stays thinking-off at 1000: 4000 to rewrite a question would
# add seconds to every chat turn.
DOC_THINKING_QUERY_REWRITE=off
DOC_MAX_TOKENS_QUERY_REWRITE=1000
DOC_THINKING_BRIEF=on
DOC_MAX_TOKENS_BRIEF=13000
DOC_THINKING_OUTLINE=on
DOC_MAX_TOKENS_OUTLINE=12000
# The deck is ONE call for every slide, JSON only; reasoning off by default.
# Turning DOC_THINKING_DECK=on floors its max_tokens at 24000 instead.
DOC_THINKING_DECK=off
DOC_MAX_TOKENS_DECK=16000
# VERIFY is one call for the whole deck and only lists unsupported claims.
DOC_THINKING_VERIFY=off
DOC_MAX_TOKENS_VERIFY=4000

# Upper bound for any single call. A provider 400 that rejects max_tokens is
# detected at runtime and the call is retried at half the size.
DOC_MAX_TOKENS_CEILING=32000

# Wall clock cap per model call, and total attempts including the first.
DOC_LLM_CALL_TIMEOUT_MS=120000
DOC_LLM_ATTEMPTS=3

# Concurrent model calls and concurrent hybrid searches. Above 3 each, the
# database starts cancelling search statements on timeout.
DOC_LLM_CONCURRENCY=3
DOC_SEARCH_CONCURRENCY=3
